# Esta llave simétrica se usa para las inserciones de las contraseñas
# a la base de datos, se debe ingresar manualmente.
MARIADB_DATABASE_SYMMETRIC_KEY=""

# Esta contraseña inicial es para el correcto funcionamiento con el
# programa, pues si detecta que una contraseña no está encriptada
# según la llave simétrica, el programa se detiene por seguridad.
# Debe ser cambiada manualmente, preferiblemente debe cambiarse
# inmediatamente a otra contraseña tras arrancar el programa y
# autenticar el administrador raíz.
ROOT_ADMIN_INITIAL_PASSWORD="administrador12345"
